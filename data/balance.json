    "overrange": {
      "_comment": "超出武器最大射程的强攻：最远可打到 range_max × range_multiplier；命中率按倍数衰减，每多 1 格再扣固定值，且必定不暴击；近战武器不适用。",
      "range_multiplier": 2,
      "hit_multiplier": 0.30,
      "per_hex_penalty": 0.05,
